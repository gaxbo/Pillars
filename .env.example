# Copy to .env and fill in. Never commit .env.
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev only: set to true to skip sign-in and run on mock data.
VITE_BYPASS_AUTH=

# Landing page only: the app's address, for the nav's early access sign-in.
# Defaults to http://localhost:5173 in dev.
VITE_APP_URL=

# App only, optional: the support address on Help & Support, and the landing
# site (for the roadmap link on About Us). Each line is hidden until set.
VITE_SUPPORT_EMAIL=
VITE_LANDING_URL=
